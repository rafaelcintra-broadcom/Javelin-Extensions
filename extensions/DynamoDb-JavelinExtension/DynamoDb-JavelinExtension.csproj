<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net461</TargetFramework>
    <AssemblyName>GridTools.Javelin.DynamoDbActivities</AssemblyName>
    <RootNamespace>GridTools.Javelin.DynamoDbActivities</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Broadcom / TDM</Authors>
    <Company>Broadcom</Company>
    <Description>Broadcom Javelin Custom Activity for Amazon DynamoDB / DocumentDB Prod to Non-Prod In-Flight Zero-Leakage Data Masking Migration.</Description>
    <Copyright>Copyright © 2026 Broadcom Inc.</Copyright>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.DynamoDBv2" Version="3.7.100" />
    <PackageReference Include="Newtonsoft.Json" Version="12.0.3" />
    <PackageReference Include="System.Runtime.InteropServices.RuntimeInformation" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Activities" />
    <Reference Include="System.Xaml" />
    <Reference Include="System.Net.Http" />
    <Reference Include="GridTools.Javelin.Common">
      <HintPath>libs\GridTools.Javelin.Common.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

</Project>
