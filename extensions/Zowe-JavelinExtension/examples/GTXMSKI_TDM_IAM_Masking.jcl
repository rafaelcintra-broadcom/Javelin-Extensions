//GTXMSKI  JOB (41000000),'MASK IAM VBCAD',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M,USER=I417777
//GTLIB JCLLIB ORDER=SYSP.TDM.A.MVSF.LIB.PROC
//*-------------------------------------------------------------------*
//* STEP 01: DEFINE O ARQUIVO IAM HERDANDO OS METADADOS DE ENTRADA    *
//*          (KEYS, RECORDSIZE, CISZ COPIADOS DE PP.VB.VK.VBCADPRO)   *
//*-------------------------------------------------------------------*
//DEFIAM   EXEC PGM=IDCAMS
//SYSPRINT DD SYSOUT=*
//IAMPRINT DD SYSOUT=*
//SYSIN    DD *
  DELETE SYSP.TDM.A.MVSF.TEMP.TEST.MASKED.IAM PURGE
  SET MAXCC = 0

  DEFINE CLUSTER -
    (NAME(SYSP.TDM.A.MVSF.TEMP.TEST.MASKED.IAM) -
     MODEL(PP.VB.VK.VBCADPRO) -
     OWNER($IAM))
/*
//*-------------------------------------------------------------------*
//* STEP 02: EXECUTA O MASQUEAMENTO DO TDM GERANDO O ARQUIVO STAGING  *
//*-------------------------------------------------------------------*
//GTMSK EXEC PROC=GTMSKFV,LOADLIB='SYSP.TDM.A.MVSF.LIB.LOAD',
//  MSGDS='SYSP.TDM.A.MVSF.MSG.KSDS',
//  PARMLIB='SYSP.TDM.A.MVSF.LIB.PARM',
//  REPHLQ='SYSP.TDM.A.MVSF.TEMP.AUDIT',
//  INDS='PP.VB.VK.VBCADPRO',
//  OUTDS='SYSP.TDM.A.MVSF.TEMP.TEST.MASKED.SEQ',
//  DEFDS='SYSP.TDM.A.MVSF.LIB.DEF(VBCAD)',
//  MAPDS='SYSP.TDM.A.MVSF.LIB.MAP(VBMAP)',
//  LRECL='2300',RECFM='FB',BLKSIZE='27600',
//  AUDPRI='1',AUDSEC='1'
//*
//STEP03.PARMCD DD *
--LANGUAGE
LANGUAGE=EN
--QUOTESTYLE=DOUBLE OR SINGLE
QUOTESTYLE=DOUBLE
/*
//STEP04.PARMCD DD *
--LANGUAGE
LANGUAGE=EN
--QUOTESTYLE=DOUBLE OR SINGLE
QUOTESTYLE=DOUBLE
MAPTYPE=FILE
/*
//STEP05.PARMCD DD *
--LANGUAGE=EN (THE DEFAULT)
XREFSCHEMA=GRIDTOOL
SEEDSCHEMA=GRIDTOOL
SUBSETSCHEMA=GRIDTOOL
AUDIT=ALL
COMMIT=1000
PROGRESSCOUNT=100
/*
//STEP05.SYSTSIN  DD *
  CALL 'SYSP.TDM.A.MVSF.LIB.LOAD(GTXMSKF)'
/*
//*-------------------------------------------------------------------*
//* STEP 03: REPRO CARREGANDO OS DADOS MASCARADOS NO ARQUIVO IAM      *
//*-------------------------------------------------------------------*
//LOADIAM  EXEC PGM=IDCAMS,COND=(4,LT)
//SYSPRINT DD SYSOUT=*
//IAMPRINT DD SYSOUT=*
//INPUT    DD DISP=SHR,DSN=SYSP.TDM.A.MVSF.TEMP.TEST.MASKED.SEQ
//OUTPUT   DD DISP=SHR,DSN=SYSP.TDM.A.MVSF.TEMP.TEST.MASKED.IAM
//SYSIN    DD *
  REPRO INFILE(INPUT) OUTFILE(OUTPUT)
/*
