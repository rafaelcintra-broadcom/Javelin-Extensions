<Flowchart mc:Ignorable="sap sap2010 sads" mva:VisualBasic.Settings="{x:Null}" sap2010:WorkflowViewState.IdRef="Flowchart_1"
 xmlns="http://schemas.microsoft.com/netfx/2009/xaml/activities"
 xmlns:av="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:gjc="clr-namespace:GridTools.Javelin.Common;assembly=GridTools.Javelin.Common"
 xmlns:gjd="clr-namespace:GridTools.Javelin.Designer;assembly=Javelin"
 xmlns:gjm="clr-namespace:GridTools.Javelin.MongoDbActivities;assembly=GridTools.Javelin.MongoDbActivities"
 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
 xmlns:mva="clr-namespace:Microsoft.VisualBasic.Activities;assembly=System.Activities"
 xmlns:s="clr-namespace:System;assembly=mscorlib"
 xmlns:sads="http://schemas.microsoft.com/netfx/2010/xaml/activities/debugger"
 xmlns:sap="http://schemas.microsoft.com/netfx/2009/xaml/activities/presentation"
 xmlns:sap2010="http://schemas.microsoft.com/netfx/2010/xaml/activities/presentation"
 xmlns:scg="clr-namespace:System.Collections.Generic;assembly=mscorlib"
 xmlns:sco="clr-namespace:System.Collections.ObjectModel;assembly=mscorlib"
 xmlns:sd="clr-namespace:System.Data;assembly=System.Data"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <TextExpression.Namespaces>
    <sco:Collection x:TypeArguments="x:String">
      <x:String>System.Activities</x:String>
      <x:String>System.Activities.Statements</x:String>
      <x:String>System.Activities.Expressions</x:String>
      <x:String>System.Activities.Validation</x:String>
      <x:String>System.Activities.XamlIntegration</x:String>
      <x:String>System.Windows.Controls</x:String>
      <x:String>System.Windows.Documents</x:String>
      <x:String>System.Windows.Shapes</x:String>
      <x:String>System.Windows.Shell</x:String>
      <x:String>System.Windows.Navigation</x:String>
      <x:String>System.Windows.Data</x:String>
      <x:String>System.Windows</x:String>
      <x:String>System.Windows.Controls.Primitives</x:String>
      <x:String>System.Windows.Media.Animation</x:String>
      <x:String>System.Windows.Input</x:String>
      <x:String>System.Windows.Media</x:String>
      <x:String>System.Diagnostics</x:String>
      <x:String>System.Windows.Media.Imaging</x:String>
      <x:String>System.Windows.Media.TextFormatting</x:String>
      <x:String>System.Windows.Automation</x:String>
      <x:String>System.Windows.Media.Effects</x:String>
      <x:String>System.Windows.Media.Media3D</x:String>
      <x:String>System.Windows.Ink</x:String>
      <x:String>System.Windows.Forms.Integration</x:String>
      <x:String>GridTools.Javelin.Designer</x:String>
      <x:String>GridTools.Javelin.MongoDbActivities</x:String>
      <x:String>Microsoft.VisualBasic.Activities</x:String>
      <x:String>System</x:String>
      <x:String>System.Activities.Debugger.Symbol</x:String>
      <x:String>System.Collections.Generic</x:String>
      <x:String>System.Data</x:String>
      <x:String>System.Xml.Serialization</x:String>
      <x:String>System.Windows.Markup</x:String>
    </sco:Collection>
  </TextExpression.Namespaces>
  <TextExpression.References>
    <sco:Collection x:TypeArguments="AssemblyReference">
      <AssemblyReference>System.Activities</AssemblyReference>
      <AssemblyReference>PresentationFramework</AssemblyReference>
      <AssemblyReference>WindowsBase</AssemblyReference>
      <AssemblyReference>PresentationCore</AssemblyReference>
      <AssemblyReference>WPFToolkit</AssemblyReference>
      <AssemblyReference>WindowsFormsIntegration</AssemblyReference>
      <AssemblyReference>Javelin</AssemblyReference>
      <AssemblyReference>GridTools.Javelin.MongoDbActivities</AssemblyReference>
      <AssemblyReference>mscorlib</AssemblyReference>
      <AssemblyReference>System.Core</AssemblyReference>
      <AssemblyReference>System</AssemblyReference>
      <AssemblyReference>System.ServiceModel</AssemblyReference>
      <AssemblyReference>System.Runtime.WindowsRuntime</AssemblyReference>
      <AssemblyReference>System.Data</AssemblyReference>
      <AssemblyReference>System.Xml</AssemblyReference>
      <AssemblyReference>System.Xaml</AssemblyReference>
    </sco:Collection>
  </TextExpression.References>
  <Flowchart.Variables>
    <Variable x:TypeArguments="x:String" Name="vaultFilePath" />
    <Variable x:TypeArguments="x:String" Name="vaultSessionId" />
    <Variable x:TypeArguments="x:Int64" Name="extractedCount" />
    <Variable x:TypeArguments="x:String" Name="sha256Hash" />
    <Variable x:TypeArguments="x:Int64" Name="loadedCount" />
    <Variable x:TypeArguments="x:Int32" Name="piiMaskedCount" />
    <Variable x:TypeArguments="x:Boolean" Name="vaultShredded" />
    <Variable x:TypeArguments="x:String" Name="auditSummaryJson" />
    <Variable x:TypeArguments="x:Int64" Name="pipelineExecTimeMs" />
  </Flowchart.Variables>
  <Flowchart.StartNode>
    <x:Reference>__ReferenceID0</x:Reference>
  </Flowchart.StartNode>

  <!-- Step 1: Extração de PROD para Cofre Seguro com EFS / ACLs -->
  <FlowStep x:Name="__ReferenceID0" sap2010:WorkflowViewState.IdRef="FlowStep_1">
    <gjd:JGuid.JGuid>
      <s:Guid>a1b2c3d4-e5f6-4a7b-8c9d-0e1f2a3b4c5d</s:Guid>
    </gjd:JGuid.JGuid>
    <gjm:MongoExtractToVaultActivity ContinueOnError="{x:Null}" Timeout="{x:Null}"
      ConnectionString="MONGO_PROD_CLUSTER"
      DatabaseName="banking_prod"
      CollectionName="clientes"
      FilterJson="{}{'status': 'ATIVO'}"
      Limit="[5000]"
      ApplyMaskingInFlight="False"
      VaultFilePath="[vaultFilePath]"
      VaultSessionId="[vaultSessionId]"
      ExtractedCount="[extractedCount]"
      Sha256Checksum="[sha256Hash]"
      sap2010:WorkflowViewState.IdRef="MongoExtractToVaultActivity_1" />
    <FlowStep.Next>
      <FlowStep x:Name="__ReferenceID1">
        <gjd:JGuid.JGuid>
          <s:Guid>b2c3d4e5-f6a7-4b8c-9d0e-1f2a3b4c5d6e</s:Guid>
        </gjd:JGuid.JGuid>
        <gjc:LogActivity ContinueOnError="{x:Null}" Timeout="{x:Null}"
          MessageToLog="[&quot;[Javelin] Extração para o cofre concluída com sucesso! Sessão: &quot; &amp; vaultSessionId &amp; &quot; | Documentos: &quot; &amp; extractedCount.ToString() &amp; &quot; | SHA256: &quot; &amp; sha256Hash &amp; &quot; | Arquivo Seguro: &quot; &amp; vaultFilePath]"
          sap2010:WorkflowViewState.IdRef="LogActivity_1" />
        <FlowStep.Next>
          <!-- Step 2: Carga do Cofre para NÃO-PROD usando Tag Template do Data Assistant e Zero-Fill Forense -->
          <FlowStep x:Name="__ReferenceID2">
            <gjd:JGuid.JGuid>
              <s:Guid>c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f</s:Guid>
            </gjd:JGuid.JGuid>
            <gjm:MongoVaultToTargetActivity ContinueOnError="{x:Null}" Timeout="{x:Null}"
              VaultFilePath="[vaultFilePath]"
              TargetConnectionString="MONGO_HML_CLUSTER"
              TargetDatabaseName="banking_qa"
              TargetCollectionName="clientes"
              DataAssistantTagTemplate="MONGODB_PII_TAG_TEMPLATE"
              WriteMode="Upsert"
              UpsertKeyField="_id"
              BatchSize="[1000]"
              AutoShredVaultOnComplete="True"
              LoadedCount="[loadedCount]"
              TotalPiiFieldsMasked="[piiMaskedCount]"
              VaultShredded="[vaultShredded]"
              sap2010:WorkflowViewState.IdRef="MongoVaultToTargetActivity_1" />
            <FlowStep.Next>
              <FlowStep x:Name="__ReferenceID3">
                <gjd:JGuid.JGuid>
                  <s:Guid>d4e5f6a7-b8c9-4d0e-1f2a-3b4c5d6e7f8a</s:Guid>
                </gjd:JGuid.JGuid>
                <gjc:LogActivity ContinueOnError="{x:Null}" Timeout="{x:Null}"
                  MessageToLog="[&quot;[Javelin] Carga em NÃO-PROD finalizada! Documentos: &quot; &amp; loadedCount.ToString() &amp; &quot; | Campos PII Mascarados: &quot; &amp; piiMaskedCount.ToString() &amp; &quot; | Cofre Sanitizado (Zero-Fill 0x00): &quot; &amp; vaultShredded.ToString()]"
                  sap2010:WorkflowViewState.IdRef="LogActivity_2" />
                <FlowStep.Next>
                  <!-- Step 3: Pipeline Direto Prod -> Cofre -> Data Assistant Template -> Não-Prod (Tudo em Um) -->
                  <FlowStep x:Name="__ReferenceID4">
                    <gjd:JGuid.JGuid>
                      <s:Guid>e5f6a7b8-c9d0-4e1f-2a3b-4c5d6e7f8a9b</s:Guid>
                    </gjd:JGuid.JGuid>
                    <gjm:MongoProdToNonProdPipelineActivity ContinueOnError="{x:Null}" Timeout="{x:Null}"
                      SourceConnectionString="MONGO_PROD_CLUSTER"
                      SourceDatabaseName="banking_prod"
                      SourceCollectionName="pedidos"
                      SourceFilterJson="{}{'status': 'PROCESSADO'}"
                      Limit="[2000]"
                      TargetConnectionString="MONGO_HML_CLUSTER"
                      TargetDatabaseName="banking_qa"
                      TargetCollectionName="pedidos"
                      DataAssistantTagTemplate="MONGODB_PII_TAG_TEMPLATE"
                      WriteMode="Insert"
                      BatchSize="[1000]"
                      DryRun="False"
                      AutoShredVault="True"
                      TotalProcessedCount="[loadedCount]"
                      TotalPiiFieldsMasked="[piiMaskedCount]"
                      VaultSessionId="[vaultSessionId]"
                      ExecutionTimeMs="[pipelineExecTimeMs]"
                      AuditSummaryJson="[auditSummaryJson]"
                      sap2010:WorkflowViewState.IdRef="MongoProdToNonProdPipelineActivity_1" />
                    <FlowStep.Next>
                      <FlowStep x:Name="__ReferenceID5">
                        <gjd:JGuid.JGuid>
                          <s:Guid>f6a7b8c9-d0e1-4f2a-3b4c-5d6e7f8a9b0c</s:Guid>
                        </gjd:JGuid.JGuid>
                        <gjc:LogActivity ContinueOnError="{x:Null}" Timeout="{x:Null}"
                          MessageToLog="[&quot;[Javelin Audit] Resumo do Pipeline TDM Direto:&quot; &amp; Environment.NewLine &amp; auditSummaryJson]"
                          sap2010:WorkflowViewState.IdRef="LogActivity_3" />
                      </FlowStep>
                    </FlowStep.Next>
                  </FlowStep>
                </FlowStep.Next>
              </FlowStep>
            </FlowStep.Next>
          </FlowStep>
        </FlowStep.Next>
      </FlowStep>
    </FlowStep.Next>
  </FlowStep>
  <x:Reference>__ReferenceID1</x:Reference>
  <x:Reference>__ReferenceID2</x:Reference>
  <x:Reference>__ReferenceID3</x:Reference>
  <x:Reference>__ReferenceID4</x:Reference>
  <x:Reference>__ReferenceID5</x:Reference>
</Flowchart>
